{
  "name": "vue-pinia-social-scheduler",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc -b tsconfig.node.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test && vite build"
  },
  "dependencies": {
    "@date-fns/tz": "latest",
    "@fontsource-variable/inter": "latest",
    "@vueuse/core": "latest",
    "date-fns": "latest",
    "lucide-vue-next": "latest",
    "pinia": "latest",
    "vue": "latest",
    "vue-router": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "latest",
    "@types/node": "latest",
    "@vitejs/plugin-vue": "latest",
    "@vue/test-utils": "latest",
    "eslint": "latest",
    "eslint-plugin-vue": "latest",
    "globals": "^17.13.0",
    "happy-dom": "latest",
    "prettier": "latest",
    "tailwindcss": "latest",
    "typescript": "^6.0.3",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "latest",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "latest"
  }
}
